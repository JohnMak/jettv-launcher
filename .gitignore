# Whitelist mode: ignore everything at the repo root except the published files.
/*
!/.gitignore
!/AGENTS.md
!/CLAUDE.md
!/README.md
!/launcher/
!/.github/
!/.beads/
!/docs/
!/tools/

# tools/: only the published scripts and lists
/tools/*
!/tools/build-and-install.sh
!/tools/setup-device.sh
!/tools/debloat.sh
!/tools/undebloat.sh
!/tools/debloat/

# Beads runtime files (dolt data dirs are ignored by .beads/.gitignore)
.beads/dolt-monitor.pid.lock

# Secrets and local-only material, wherever they are
.dolt/
*.db
*.jks
*.keystore
.adbkey*
local.properties
.env*
