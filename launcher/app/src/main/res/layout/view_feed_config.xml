<?xml version="1.0" encoding="utf-8"?>
<!-- Hidden «настроить» icon at the left of a feed row; width + gap = FeedPageShift.configShiftDp(). Top margin is set in code. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="26dp"
    android:layout_height="match_parent"
    android:layout_marginStart="56dp"
    android:alpha="0"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/config_image"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:contentDescription="@string/feed_configure"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_sliders_horizontal" />
</FrameLayout>
